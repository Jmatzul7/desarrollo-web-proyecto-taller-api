@TallerMecanicoAPI_HostAddress = http://localhost:5216
@token = PEGAR_AQUI_EL_TOKEN_DEVUELTO_POR_LOGIN

### Login
POST {{TallerMecanicoAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "nombreUsuario": "admin",
  "password": "Admin123!"
}

###

### Listar clientes (requiere token)
GET {{TallerMecanicoAPI_HostAddress}}/api/clientes
Authorization: Bearer {{token}}

###

### Crear cliente
POST {{TallerMecanicoAPI_HostAddress}}/api/clientes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan Perez",
  "telefono": "5555-1234",
  "email": "juan@correo.com",
  "direccion": "Zona 10, Guatemala"
}

###

### Crear vehiculo
POST {{TallerMecanicoAPI_HostAddress}}/api/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "placa": "P123ABC",
  "marca": "Toyota",
  "modelo": "Corolla",
  "anio": 2020,
  "color": "Gris",
  "idCliente": 1
}

###

### Crear orden de trabajo
POST {{TallerMecanicoAPI_HostAddress}}/api/ordenestrabajo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idVehiculo": 1,
  "idMecanico": 2,
  "observaciones": "El vehiculo no enciende"
}

###

### Registrar diagnostico
POST {{TallerMecanicoAPI_HostAddress}}/api/diagnosticos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idOrden": 1,
  "idMecanico": 2,
  "descripcionFalla": "Bateria descargada y terminales oxidados"
}

###

### Registrar reparacion (queda Pendiente)
POST {{TallerMecanicoAPI_HostAddress}}/api/reparaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idDiagnostico": 1,
  "descripcion": "Cambio de bateria y limpieza de terminales",
  "orden": 1,
  "costoManoObra": 150.00
}

###

### Autorizar reparacion
PATCH {{TallerMecanicoAPI_HostAddress}}/api/reparaciones/1/autorizar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "aprobar": true
}

###

### Usar un repuesto en la reparacion (requiere justificacion)
POST {{TallerMecanicoAPI_HostAddress}}/api/reparaciones/1/repuestos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idRepuesto": 1,
  "cantidad": 1,
  "justificacion": "Bateria original agotada, se reemplaza segun diagnostico"
}

###

### Generar factura de la orden
POST {{TallerMecanicoAPI_HostAddress}}/api/facturas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idOrden": 1
}

###
